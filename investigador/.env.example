# Usa el mismo token que FastAPI.
CONFORME_EVE_TOKEN=

# Local: chatgpt usa tu sesión de ChatGPT en eve dev, sin clave API.
# Alternativas: openai/<modelo> + OPENAI_API_KEY,
# anthropic/<modelo> + ANTHROPIC_API_KEY, o modelo de AI Gateway.
CONFORME_EVE_MODELO=chatgpt
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
