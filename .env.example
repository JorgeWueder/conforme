# Copia este archivo como .env y completa los valores. El .env NO se versiona.

# Rama "dev" de Neon (usa la URL con pooler).
DATABASE_URL=

# Rama "test" de Neon. Las pruebas BORRAN y recrean el esquema de esta base:
# debe ser una base dedicada y distinta de DATABASE_URL.
DATABASE_URL_TEST=

# Contraseña común de los usuarios de demostración (la usa scripts/sembrar.py).
DEMO_PASSWORD=

# URL pública de la app (para el QR, fase 3).
BASE_URL=http://localhost:8501
