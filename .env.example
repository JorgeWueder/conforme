# Copia este archivo como .env y completa los valores. El .env NO se versiona.

# Rama "dev" de Neon (usa la URL con pooler).
DATABASE_URL=

# Rama "test" de Neon. Las pruebas BORRAN y recrean el esquema de esta base:
# debe ser una base dedicada y distinta de DATABASE_URL.
DATABASE_URL_TEST=

# Rama "demo" de Neon (la del despliegue; para sembrarla, ponla como DATABASE_URL en esa ejecución).
DATABASE_URL_DEMO=

# Contraseña común de los usuarios de demostración (la usa scripts/sembrar.py).
DEMO_PASSWORD=

# URL pública de React para los QR (opcional; por defecto se usa el origen actual).
BASE_URL=

# Secreto aleatorio compartido por los procesos de la API. Vacío en desarrollo
# genera una clave al arrancar y las sesiones vencen cuando se reinicia el proceso.
SESSION_SECRET=

# F4: la lectura del TDR usa eve si CONFORME_EVE_URL y TOKEN están configurados.
# Alternativa directa: LLM_PROVIDER = anthropic u openai.
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Revisión previa: habilita el caso ficticio solo en entornos de demo.
PREVENCION_DEMO=1

# Investigador documental (opcional en demo). Configura el mismo token en eve y FastAPI.
CONFORME_EVE_URL=
CONFORME_EVE_TOKEN=

# Índice web de documentos públicos. Es opcional si el dataset enlaza los actos.
PREVENCION_BRAVE_API_KEY=
